fig, axes = plt.subplots(2, 2, figsize=(14, 11))

# Temperature Distribution by Weather Class
df.boxplot(column='temperature_2m', by='Weather_Class', ax=axes[0, 0])
axes[0, 0].set_title('Temperature Distribution by Weather Class', fontsize=12, fontweight='bold')
